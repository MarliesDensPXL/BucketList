<Window x:Class="BucketList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BucketList"
        mc:Ignorable="d"
        Title="Bucket List"
        Height="500" Width="900" Background="PaleGoldenrod" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <Image Grid.Column="0" x:Name="placeImage" Margin="20" HorizontalAlignment="Left" Width="260"/>
        <StackPanel Grid.Column="1" Orientation="Vertical"  >
            <Label Grid.Column="1"  Margin="20,20,20,0" HorizontalAlignment="Left"
       Width="260"
       VerticalAlignment="Top">
                To Visit
            </Label>
            <ListBox x:Name="toVisitListBox"  Margin="20" HorizontalAlignment="Left" Width="260" Height="180" SelectionChanged="OnCountryToVisitChanged" />
            <ComboBox x:Name="selectedPlaceComboBox"  Width="260" Height="30" SelectionChanged="OnSelectedPlaceChanged"/>
            <CheckBox x:Name="isVisitedCheckBox" Content="Is Visited" Margin="20,20,20,0" Checked="OnIsVisitedCheckBoxChecked"/>
            <TextBlock   Name="nameTextBlock" Margin="20,20,20,0">Name</TextBlock>
            <TextBlock  Name="cityTextBlock" Margin="20,20,20,0">City</TextBlock>
            <TextBlock x:Name="descriptionTextBlock" Text="Description" Margin="20"  TextWrapping="Wrap"/>

        </StackPanel>

       <StackPanel Grid.Column="2">
            <Label Grid.Column="2" Margin="20" HorizontalAlignment="Left" VerticalAlignment="Top">
                Rate place
            </Label>
            <TextBox x:Name="ratePlaceTextBox" HorizontalAlignment="Left" Margin="20,0,20,0" Width="240" TextChanged="OnRatePlaceTextBoxTextChanged"/>
            <Button Margin="20"
        VerticalAlignment="Top"
        HorizontalAlignment="Left"
        Width="240" Height="30" Click="RateButton_Click">
                Rate Place</Button>
            <Label 
    Margin="20"
       HorizontalAlignment="Left"
       VerticalAlignment="Top"
       >
                Rated places
            </Label>
            <ListBox x:Name="ratedPlacesListBox" Height="100" Margin="20,0,20,0"/>
        </StackPanel>
        
    </Grid>
</Window>
